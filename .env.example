# GEMINI_API_KEY: Server-only secret required for Gemini semantic short-answer grading.
# Never expose with NEXT_PUBLIC_. In Firebase App Hosting, store in Cloud Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_GRADING_MODEL: Optional override for the server-side Gemini grading model.
GEMINI_GRADING_MODEL="gemini-3-flash-preview"

# NEXT_PUBLIC_SITE_URL: Production canonical domain used for SEO metadata, OpenGraph, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://ais-pre-m5smnqvfyxyrlvrkl76egf-965456113659.europe-west2.run.app"

# APP_URL: Runtime service URL injected by Cloud Run / AI Studio when NEXT_PUBLIC_SITE_URL is not set.
APP_URL="https://ais-pre-m5smnqvfyxyrlvrkl76egf-965456113659.europe-west2.run.app"
